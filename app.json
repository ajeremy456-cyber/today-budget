{
  "expo": {
    "name": "Today Budget",
    "slug": "today-budget",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.todaybudget.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#F8FAFC"
      },
      "package": "com.todaybudget.app"
    },
    "web": {},
    "plugins": [
      "./plugins/withResolveWorkManager.js",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F8FAFC"
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "TodayBudgetWidget",
              "displayName": "今日可花",
              "description": "顯示今天還能花多少",
              "ios": {
                "supportedFamilies": ["systemSmall"]
              }
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [],
          "widgets": [
            {
              "name": "TodayBudgetWidget",
              "label": "今日可花",
              "description": "顯示今天還能花多少",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "85c7e37f-36a2-4201-85d7-76b19a30af86"
      }
    }
  }
}